  "license": "MIT",
  "keywords": ["effort", "reasoning-effort", "routing", "hooks", "mcp"],
  "mcpServers": {
    "effort": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/effort.mjs", "mcp"]
    }
  }
}
