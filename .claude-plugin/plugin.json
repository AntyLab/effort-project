{
  "name": "effort-project",
  "displayName": "The Effort Project",
  "description": "Routes prompts to a lighter or stronger model and effort through its own skills when a local rule fires, and stays silent otherwise. Includes Effort's read-only MCP tools.",
  "author": {
    "name": "The Effort Project contributors",
    "url": "https://github.com/AntyLab/effort-project"
  },
  "homepage": "https://github.com/AntyLab/effort-project/blob/main/docs/claude-code-plugin.md",
  "repository": "https://github.com/AntyLab/effort-project",
  "license": "MIT",
  "keywords": ["effort", "reasoning-effort", "routing", "hooks", "mcp"],
  "mcpServers": {
    "effort": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/effort.mjs", "mcp"]
    }
  }
}
